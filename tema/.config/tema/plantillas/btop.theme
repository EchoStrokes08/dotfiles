# btop — plantilla matugen (modo "wallpaper"). Basado en /usr/share/btop/themes/ayu.theme
# con los colores de tu paleta (colores.css). Lo copia tema.sh a ~/.local/state/tema/
theme[main_bg]="{{colors.surface.default.hex}}"
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.on_surface.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[selected_bg]="{{colors.surface_container_highest.default.hex}}"
theme[selected_fg]="{{colors.primary.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"
theme[graph_text]="{{colors.on_surface.default.hex}}"
theme[meter_bg]="{{colors.surface_container_highest.default.hex}}"
theme[proc_misc]="#D2A6FF"
theme[cpu_box]="{{colors.tertiary.default.hex}}"
theme[mem_box]="{{colors.secondary.default.hex}}"
theme[net_box]="#f07078"
theme[proc_box]="{{colors.primary.default.hex}}"
theme[div_line]="{{colors.surface_container_highest.default.hex}}"
theme[temp_start]="{{colors.secondary.default.hex}}"
theme[temp_mid]="#e6c446"
theme[temp_end]="{{colors.error.default.hex}}"
theme[cpu_start]="{{colors.tertiary.default.hex}}"
theme[cpu_mid]="#D2A6FF"
theme[cpu_end]="#f07078"
theme[free_start]="{{colors.secondary.default.hex}}"
theme[free_mid]="{{colors.secondary.default.hex}}"
theme[free_end]="{{colors.secondary_fixed_dim.default.hex}}"
theme[cached_start]="{{colors.tertiary.default.hex}}"
theme[cached_mid]="{{colors.tertiary.default.hex}}"
theme[cached_end]="{{colors.tertiary_fixed_dim.default.hex}}"
theme[available_start]="#b8cc52"
theme[available_mid]="#b8cc52"
theme[available_end]="#e9fe83"
theme[used_start]="#e6c446"
theme[used_mid]="{{colors.primary.default.hex}}"
theme[used_end]="{{colors.error.default.hex}}"
theme[download_start]="#f07078"
theme[download_mid]="#f07078"
theme[download_end]="#ff6565"
theme[upload_start]="{{colors.tertiary_fixed_dim.default.hex}}"
theme[upload_mid]="{{colors.tertiary.default.hex}}"
theme[upload_end]="{{colors.tertiary.default.hex}}"
theme[process_start]="#e6c446"
theme[process_mid]="{{colors.primary.default.hex}}"
theme[process_end]="{{colors.error.default.hex}}"
