// Configuración de waybar
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "reload_style_on_change": true,	

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "group/buds",
        "pulseaudio",
        "network",
        "backlight",
        "battery",
        "cpu",
        "memory",
        "custom/notification"
    ],

    // swaync: campana con el número de notificaciones. Clic = panel, clic derecho = No molestar
    "custom/notification": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "escape": true,
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "none": "󰂚",
            "notification": "󱅫",
            "dnd-none": "󰂛",
            "dnd-notification": "󰂛",
            "inhibited-none": "󰂚",
            "inhibited-notification": "󱅫",
            "dnd-inhibited-none": "󰂛",
            "dnd-inhibited-notification": "󰂛"
        },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#f19618'><b>{}</b></span>",
                "days": "<span color='#e5e1cf'>{}</span>",
                "weekdays": "<span color='#5c6773'><b>{}</b></span>",
                "today": "<span color='#0e1419' background='#f19618'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip-format": "{desc}"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 sin red",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "kitty -e nmtui"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo} · {power:.1f} W"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
    },

    "tray": {
        "spacing": 10,
        "icon-size": 16
    },

    // Redmi Buds 8 Pro: batería de cada audífono y del estuche (~/proyectos/redmi-buds)
    "group/buds": {
        "orientation": "horizontal",
        "modules": ["image#buds-left", "custom/buds-left", "image#buds-right", "custom/buds-right",
                    "image#buds-case", "custom/buds-case"]
    },
    "image#buds-left": {
        "exec": "~/.local/bin/buds waybar --part left --icon",
        "size": 22,
        "interval": 120,
        "signal": 8,
        "tooltip": false,
        "on-click": "~/.local/bin/buds mode next --notify",
        "on-click-middle": "~/.local/bin/buds-manager"
    },
    "custom/buds-left": {
        "exec": "~/.local/bin/buds waybar --part left",
        "return-type": "json",
        "interval": 120,
        "signal": 8,
        "on-click": "~/.local/bin/buds mode next --notify",
        "on-click-right": "~/.local/bin/buds mode toggle --notify",
        "on-click-middle": "~/.local/bin/buds-manager"
    },
    "image#buds-right": {
        "exec": "~/.local/bin/buds waybar --part right --icon",
        "size": 22,
        "interval": 120,
        "signal": 8,
        "tooltip": false,
        "on-click": "~/.local/bin/buds mode next --notify",
        "on-click-middle": "~/.local/bin/buds-manager"
    },
    "custom/buds-right": {
        "exec": "~/.local/bin/buds waybar --part right",
        "return-type": "json",
        "interval": 120,
        "signal": 8,
        "on-click": "~/.local/bin/buds mode next --notify",
        "on-click-right": "~/.local/bin/buds mode toggle --notify",
        "on-click-middle": "~/.local/bin/buds-manager"
    },
    "image#buds-case": {
        "exec": "~/.local/bin/buds waybar --part case --icon",
        "size": 22,
        "interval": 120,
        "signal": 8,
        "tooltip": false,
        "on-click": "~/.local/bin/buds mode next --notify",
        "on-click-middle": "~/.local/bin/buds-manager"
    },
    "custom/buds-case": {
        "exec": "~/.local/bin/buds waybar --part case",
        "return-type": "json",
        "interval": 120,
        "signal": 8,
        "on-click": "~/.local/bin/buds mode next --notify",
        "on-click-right": "~/.local/bin/buds mode toggle --notify",
        "on-click-middle": "~/.local/bin/buds-manager"
    }
}
