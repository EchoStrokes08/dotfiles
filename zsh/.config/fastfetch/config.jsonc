// fastfetch: lo que sale al abrir kitty. Prueba cambios con:  fastfetch
// Lista de módulos:  fastfetch --list-modules
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": { "1": "yellow", "2": "yellow" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow", "title": "magenta" }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "os",       "key": "󰣇", "format": "{name}" },
    { "type": "kernel",   "key": "\uf013" },
    { "type": "wm",       "key": "\uf2d2", "format": "{pretty-name} {version}" },
    { "type": "packages", "key": "󰏖" },
    { "type": "uptime",   "key": "󰅐" },
    { "type": "memory",   "key": "󰍛" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
